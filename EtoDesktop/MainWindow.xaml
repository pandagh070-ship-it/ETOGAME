<Window x:Class="EtoDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
    Background="#10131A" Width="820" Height="560"
    WindowStartupLocation="CenterScreen" Title="Eto Desktop">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#171B25">
      <DockPanel Margin="18,0">
        <TextBlock Text="ETO DESKTOP" Foreground="White" FontSize="18" FontWeight="Bold"
                   VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="✕" Width="42" Height="30" Margin="10,0,0,0"
                Click="Close_Click" Background="#252B38" Foreground="White" BorderThickness="0"/>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24">
        <TextBlock Text="سطح المكتب" Foreground="White" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="تحكم بالخلفية وشريط المهام والساعة من مكان واحد."
                   Foreground="#A9B0BE" Margin="0,5,0,22"/>

        <Border Background="#171B25" CornerRadius="10" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="الخلفية" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="صورة، GIF متحرك، أو فيديو." Foreground="#A9B0BE" Margin="0,4,0,12"/>
            <WrapPanel>
              <Button Content="اختيار صورة" Click="Image_Click" Margin="0,0,8,0"/>
              <Button Content="اختيار GIF" Click="Gif_Click" Margin="0,0,8,0"/>
              <Button Content="اختيار فيديو" Click="Video_Click"/>
            </WrapPanel>
            <TextBlock x:Name="BackgroundLabel" Text="لا توجد خلفية مخصصة" Foreground="#7DCEFF" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="#171B25" CornerRadius="10" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="شريط المهام" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="شريط ETO خفيف أسفل الشاشة بدل شريط Windows." Foreground="#A9B0BE" Margin="0,4,0,12"/>
            <CheckBox x:Name="TaskbarEnabled" Content="تفعيل شريط ETO" IsChecked="True"
                      Foreground="White" Click="TaskbarEnabled_Click"/>
          </StackPanel>
        </Border>

        <Border Background="#171B25" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="الساعة" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="ساعة رقمية فوق سطح المكتب." Foreground="#A9B0BE" Margin="0,4,0,12"/>
            <CheckBox x:Name="ClockEnabled" Content="إظهار الساعة" IsChecked="True"
                      Foreground="White" Click="ClockEnabled_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#171B25">
      <DockPanel Margin="18,0">
        <TextBlock x:Name="StatusText" Text="جاهز" Foreground="#A9B0BE" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="تطبيق على سطح المكتب" Padding="18,6"
                Click="Apply_Click" Background="#7C5CFF" Foreground="White" BorderThickness="0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>