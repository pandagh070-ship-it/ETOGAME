<Window x:Class="EtoDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Background="#10131A" Width="820" Height="560" WindowStartupLocation="CenterScreen" Title="Eto Desktop"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#171B25"><DockPanel Margin="18,0"><TextBlock Text="ETO DESKTOP" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="✕" Width="42" Height="30" Click="Close_Click"/></DockPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="24"><TextBlock Text="سطح المكتب" Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Text="خلفية فيديو/GIF + شريط مهام + ساعة" Foreground="#A9B0BE" Margin="0,5,0,22"/><Border Background="#171B25" CornerRadius="10" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="الخلفية" Foreground="White" FontSize="18" FontWeight="Bold"/><WrapPanel Margin="0,12,0,0"><Button Content="صورة" Click="Image_Click" Margin="0,0,8,0"/><Button Content="GIF" Click="Gif_Click" Margin="0,0,8,0"/><Button Content="فيديو" Click="Video_Click"/></WrapPanel><TextBlock x:Name="BackgroundLabel" Text="لا توجد خلفية" Foreground="#7DCEFF" Margin="0,12,0,0"/></StackPanel></Border><Border Background="#171B25" CornerRadius="10" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="شريط المهام" Foreground="White" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="TaskbarEnabled" Content="تفعيل شريط ETO" IsChecked="True" Foreground="White" Margin="0,12,0,0"/></StackPanel></Border><Border Background="#171B25" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="الساعة" Foreground="White" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="ClockEnabled" Content="إظهار الساعة" IsChecked="True" Foreground="